<?xml version="1.0" encoding="utf-8"?>
<!--
    Today's prayer times in the notification bar, styled like the app: a midnight panel,
    Cormorant times and the next prayer picked out in gold. The panel keeps its own colours
    so it reads the same on light and dark notification shades.
    Highlight colours are set from PrayerTimesNotification.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/notification_panel"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/fajr_container"
        style="@style/NotificationPrayer">

        <TextView
            android:id="@+id/fajr_label"
            style="@style/NotificationPrayer.Name"
            android:text="Fajr" />

        <TextView
            android:id="@+id/fajr_time"
            style="@style/NotificationPrayer.Time"
            android:text="5:04" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dhuhr_container"
        style="@style/NotificationPrayer">

        <TextView
            android:id="@+id/dhuhr_label"
            style="@style/NotificationPrayer.Name"
            android:text="Dhuhr" />

        <TextView
            android:id="@+id/dhuhr_time"
            style="@style/NotificationPrayer.Time"
            android:text="12:05" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/asr_container"
        style="@style/NotificationPrayer">

        <TextView
            android:id="@+id/asr_label"
            style="@style/NotificationPrayer.Name"
            android:text="Asr" />

        <TextView
            android:id="@+id/asr_time"
            style="@style/NotificationPrayer.Time"
            android:text="3:22" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/maghrib_container"
        style="@style/NotificationPrayer">

        <TextView
            android:id="@+id/maghrib_label"
            style="@style/NotificationPrayer.Name"
            android:text="Maghrib" />

        <TextView
            android:id="@+id/maghrib_time"
            style="@style/NotificationPrayer.Time"
            android:text="5:50" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/isha_container"
        style="@style/NotificationPrayer">

        <TextView
            android:id="@+id/isha_label"
            style="@style/NotificationPrayer.Name"
            android:text="Isha" />

        <TextView
            android:id="@+id/isha_time"
            style="@style/NotificationPrayer.Time"
            android:text="7:04" />
    </LinearLayout>

</LinearLayout>
